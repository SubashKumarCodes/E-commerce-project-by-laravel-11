# SQLite database remove
*.sqlite*

# Laravel vendor and node_modules remove
/vendor/
/node_modules/

# Laravel cache and logs remove
/storage/*.key
/storage/app/public
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*
/bootstrap/cache/*

# Environment files remove
.env
.env.*
!.env.example

# Public build output remove
/public/build
/public/assets

# Optional: jodi egulo auto-generated hoi
/public/css
/public/js
/public/font
/public/icon
/public/images

# Public folder er ei file gulo rakhte hobe
!public/.htaccess
!public/favicon.ico
!public/index.php
!public/robots.txt

# Laravel test cache remove
.phpunit.result.cache
/phpunit.xml

# IDE / Editor files remove
/.idea
/.vscode
*.sublime-project
*.sublime-workspace

# OS junk files remove
.DS_Store
Thumbs.db

# NPM / Yarn error logs remove
npm-debug.log
yarn-error.log
